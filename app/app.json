{
  "expo": {
    "name": "David",
    "slug": "david-app",
    "version": "0.1.0",
    "scheme": "david",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#A30133"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qsoftware.david"
    },
    "android": {
      "package": "com.qsoftware.david",
      "adaptiveIcon": {
        "backgroundColor": "#A30133",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}