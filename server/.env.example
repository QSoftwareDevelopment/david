# Postgres (Supabase: Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DAVID_MIGRATE=0

# Verify staff sign-ins: the project's JWT secret, or the project URL to use its published keys
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_URL=https://david.example.com

# Optional: Claude writes the replies. Without it, the deterministic agent answers.
ANTHROPIC_API_KEY=
DAVID_MODEL=claude-sonnet-5-5
# DAVID_AGENT=rules   # force the deterministic agent even if a key is set

# Protects POST /cron/tick
CRON_SECRET=

# Web build origins, comma separated
CORS_ORIGINS=

PORT=8787
